---
import { getEntry, getCollection } from 'astro:content'
const settings = await getEntry('settings', 'global')
const [projects, services, locations] = await Promise.all([
  getCollection('projects', ({ data }) => data.active !== false),
  getCollection('services'),
  getCollection('locations', ({ data }) => data.active),
])
const serviceOrder = ['drain-tile-installation', 'water-conveyance', 'land-clearing-and-grubbing']
services.sort((a,b) => serviceOrder.indexOf(a.slug) - serviceOrder.indexOf(b.slug))
locations.sort((a,b) => a.data.city.localeCompare(b.data.city))
const links = (settings.data.nav_links || []).filter(link => link.url !== '/projects' || projects.length)
const groups = links.flatMap(link => link.url === '/services' ? [
  { ...link, children: [{ label: 'All Services', url: '/services' }, ...services.map(s => ({label:s.data.nav_title, url:`/services/${s.slug}`}))] },
  ...(locations.length ? [{label:'Service Areas', url:'/service-areas', children:[{label:'All Service Areas',url:'/service-areas'}, ...locations.map(l => ({label:`${l.data.city}, ND`,url:`/service-areas/${l.slug}`}))]}] : []),
] : [{...link, children:[]}])
const current = Astro.url.pathname.replace(/\/$/, '') || '/'
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo"><img src="/images/logo.png" alt={settings.data.company_name} width="150" height="80" /></a>
    <button id="mobile-menu-btn" class="menu-toggle" aria-controls="primary-navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
    <nav id="primary-navigation" aria-label="Main navigation">
      <ul class="nav-items">
        {groups.map((item,i) => <li>
          {item.children.length ? <details class="nav-dropdown">
            <summary role="button" aria-expanded="false" aria-controls={`nav-group-${i}`} class:list={{'current':current.startsWith(item.url)}}>
              <span class="nav-label">{item.label}</span>
              <span aria-hidden="true" class="chevron">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" focusable="false"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </summary>
            <ul class="dropdown-links" id={`nav-group-${i}`}>
              {item.children.map(child => <li><a href={child.url} aria-current={current === child.url ? 'page' : undefined}>{child.label}</a></li>)}
            </ul>
          </details> : <a class="nav-link" href={item.url} aria-current={current === item.url ? 'page' : undefined}>{item.label}</a>}
        </li>)}
        <li><a class="nav-cta" href={settings.data.cta_button_link}>{settings.data.cta_button_text}</a></li>
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header{background:white;border-bottom:1px solid #f0efed;position:sticky;top:0;z-index:60}
  .header-inner{max-width:1280px;margin:auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;min-height:80px;gap:24px}
  .logo{flex-shrink:0}.logo img{height:80px;width:auto}
  .nav-items{display:flex;align-items:center;gap:22px;list-style:none;margin:0;padding:0}
  .nav-link,summary{font-size:14px;font-weight:600;color:#4b5563;white-space:nowrap;padding:14px 0}
  summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px;line-height:20px}summary::-webkit-details-marker{display:none}
  .nav-label{display:block}
  .chevron{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex:0 0 16px}
  .chevron svg{display:block;width:16px;height:16px;transform:rotate(0deg);transform-box:view-box;transform-origin:50% 50%;transition:transform 160ms ease-out}
  .nav-dropdown[open]>summary .chevron svg{transform:rotate(180deg)}
  .nav-dropdown{position:relative}.dropdown-links{position:absolute;top:100%;left:-18px;min-width:260px;max-height:calc(100dvh - 112px);overflow:auto;padding:10px;background:white;border:1px solid #e5e0d8;border-radius:12px;box-shadow:0 12px 30px #1112;list-style:none}
  .dropdown-links a{display:block;padding:12px;border-radius:6px;font-size:14px;color:#374151}
  .dropdown-links a:hover,.dropdown-links a[aria-current]{background:#f5f3ef;color:#111}.dropdown-links a[aria-current]{font-weight:700}
  .nav-link:hover,summary:hover,.current,.nav-link[aria-current]{color:#111}
  .nav-cta{display:block;background:#c8102e;color:white;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:700;white-space:nowrap}.nav-cta:hover{background:#a80d26}
  .menu-toggle{display:none}
  a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #b4975a;outline-offset:4px;border-radius:4px}
  @media(max-width:1150px){
    .header-inner{flex-wrap:wrap;padding:0 20px;gap:0}.menu-toggle{display:flex;align-items:center;gap:12px;padding:12px;font-weight:700;cursor:pointer}
    nav{width:100%;max-height:calc(100dvh - 80px);overflow:auto;padding-bottom:24px}
    .site-header.is-enhanced nav:not(.is-open){display:none}
    .nav-items{display:block}.nav-items>li{border-top:1px solid #e5e0d8}.nav-link,summary{display:flex;padding:16px 8px;font-size:16px}.nav-cta{text-align:center;margin-top:16px}
    summary{justify-content:space-between;line-height:24px}.dropdown-links{position:static;box-shadow:none;border:none;border-radius:0;background:#f5f3ef;margin-bottom:12px;max-height:none;min-width:0}.dropdown-links a{padding:12px 16px}
  }
  @media(prefers-reduced-motion:reduce){.chevron svg{transition:none}}
</style>
<script>
  const header = document.querySelector<HTMLElement>('.site-header')!
  const menuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-btn')!
  const navigation = document.querySelector<HTMLElement>('#primary-navigation')!
  const dropdowns = [...header.querySelectorAll<HTMLDetailsElement>('details')]
  header.classList.add('is-enhanced')
  function closeDropdowns(except?: HTMLDetailsElement) {
    dropdowns.forEach(detail => { if(detail !== except) detail.open = false })
  }
  function closeMenu() {
    navigation.classList.remove('is-open')
    menuButton.setAttribute('aria-expanded','false')
    closeDropdowns()
  }
  menuButton.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') !== 'true'
    navigation.classList.toggle('is-open',open)
    menuButton.setAttribute('aria-expanded',String(open))
    if(!open) closeDropdowns()
  })
  dropdowns.forEach(detail => {
    detail.addEventListener('toggle', () => {
      detail.querySelector('summary')?.setAttribute('aria-expanded',String(detail.open))
      if(detail.open) closeDropdowns(detail)
    })
    detail.addEventListener('focusout', () => {
      setTimeout(() => { if(!detail.contains(document.activeElement)) detail.open = false },0)
    })
  })
  document.addEventListener('click', event => { if(!header.contains(event.target as Node)) closeMenu() })
  header.addEventListener('keydown', event => {
    if(event.key !== 'Escape') return
    const detail = (event.target as HTMLElement).closest<HTMLDetailsElement>('details[open]')
    if(detail){ detail.open = false; detail.querySelector('summary')?.focus() }
    else if(navigation.classList.contains('is-open')){closeMenu();menuButton.focus()}
  })
  navigation.addEventListener('click', event => {if((event.target as HTMLElement).closest('a')) closeMenu()})
  window.addEventListener('pageshow', closeMenu)
  window.matchMedia('(min-width:1151px)').addEventListener('change', closeMenu)
</script>
