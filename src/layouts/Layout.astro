---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Deep Roots Drainage — Professional drain tile installation and waterproofing services in North Dakota.' } = Astro.props
const siteName = 'Deep Roots Drainage'
const documentTitle = title.includes(siteName) ? title : `${title} | ${siteName}`

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.deeprootsdrainage.com/#organization',
  name: 'Deep Roots Drainage',
  url: 'https://www.deeprootsdrainage.com/',
  telephone: '+17014993917',
  email: 'info@deeprootsdrainage.com',
  description:
    'Professional agricultural drain tile installation serving farmers and landowners across North Dakota. Deep Roots Drainage delivers precision drain tile construction, water conveyance, and land clearing services.',
  image: 'https://www.deeprootsdrainage.com/images/uploads/drd-group-crop-2.jpg',
  logo: 'https://www.deeprootsdrainage.com/images/logo.png',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Fargo',
    addressRegion: 'ND',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Renville County, ND' },
    { '@type': 'AdministrativeArea', name: 'Ward County, ND' },
    { '@type': 'AdministrativeArea', name: 'Bottineau County, ND' },
    { '@type': 'AdministrativeArea', name: 'Rollette County, ND' },
    { '@type': 'AdministrativeArea', name: 'Towner County, ND' },
    { '@type': 'AdministrativeArea', name: 'Cavalier County, ND' },
    { '@type': 'AdministrativeArea', name: 'Pembina County, ND' },
    { '@type': 'AdministrativeArea', name: 'Walsh County, ND' },
    { '@type': 'AdministrativeArea', name: 'Ramsey County, ND' },
    { '@type': 'AdministrativeArea', name: 'Benson County, ND' },
    { '@type': 'AdministrativeArea', name: 'Pierce County, ND' },
    { '@type': 'AdministrativeArea', name: 'McHenry County, ND' },
    { '@type': 'AdministrativeArea', name: 'Wells County, ND' },
    { '@type': 'AdministrativeArea', name: 'Eddy County, ND' },
    { '@type': 'AdministrativeArea', name: 'Nelson County, ND' },
    { '@type': 'AdministrativeArea', name: 'Grand Forks County, ND' },
    { '@type': 'AdministrativeArea', name: 'Foster County, ND' },
    { '@type': 'AdministrativeArea', name: 'Griggs County, ND' },
    { '@type': 'AdministrativeArea', name: 'Steele County, ND' },
    { '@type': 'AdministrativeArea', name: 'Traill County, ND' },
    { '@type': 'AdministrativeArea', name: 'Stutsman County, ND' },
    { '@type': 'AdministrativeArea', name: 'Barnes County, ND' },
    { '@type': 'AdministrativeArea', name: 'Cass County, ND' },
    { '@type': 'AdministrativeArea', name: 'LaMoure County, ND' },
    { '@type': 'AdministrativeArea', name: 'Ransom County, ND' },
    { '@type': 'AdministrativeArea', name: 'Richland County, ND' },
    { '@type': 'AdministrativeArea', name: 'Sargent County, ND' },
    { '@type': 'AdministrativeArea', name: 'Dickey County, ND' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Agricultural Drainage Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Agricultural Drain Tile Installation',
          description:
            'GPS-guided drain tile installation including pattern tiling, custom spacing based on soil type, professionally designed tile plans, lift stations, control structures, and gravity outlets.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Water Conveyance Systems',
          description:
            'Ditch cleaning, permitted ditch enhancement, ditch reconstruction, and snagging and clearing to ensure tiled fields operate at peak performance.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Land Clearing and Grubbing',
          description:
            'Transforming nonproductive ground into high value farmland including tree and shelterbelt removal, clearing unwanted vegetation, and rock pile burial or removal.',
        },
      },
    ],
  },
  sameAs: [
    'https://www.facebook.com/people/Deep-Roots-Drainage/61589146087600/',
    'https://www.instagram.com/deeprootsdrainage/',
  ],
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MG8FHDCF');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{documentTitle}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D8PTN81KHM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-D8PTN81KHM');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <!-- CMS admin at /admin/ -->
  </head>
  <body class="bg-white text-gray-900 font-body antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MG8FHDCF" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Scripts -->
  </body>
</html>
