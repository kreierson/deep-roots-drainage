---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
export const prerender = true
export async function getStaticPaths() {
  return (await getCollection('locations', ({data}) => data.active)).map(page => ({params:{slug:page.slug},props:{page}}))
}
const {page} = Astro.props
const {data} = page
const {Content} = await page.render()
const locations = (await getCollection('locations', ({data}) => data.active)).sort((a,b) => a.data.city.localeCompare(b.data.city))
const services = await getCollection('services')
const url = `https://www.deeprootsdrainage.com/service-areas/${page.slug}`
const schema = {
  '@context':'https://schema.org', '@type':'Service', '@id':`${url}#service`,
  name:data.title, url, description:data.seo_description,
  serviceType:'Agricultural drain tile installation',
  provider:{'@id':'https://www.deeprootsdrainage.com/#organization'},
  areaServed:{'@type':'City',name:data.city, containedInPlace:{'@type':'State',name:'North Dakota'}},
}
---
<Layout title={data.seo_title} description={data.seo_description}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </Fragment>
  <section class="bg-surface py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-600 mb-8"><a href="/" class="hover:underline">Home</a><span class="mx-2" aria-hidden="true">/</span><a href="/service-areas" class="hover:underline">Service Areas</a><span class="mx-2" aria-hidden="true">/</span><span aria-current="page">{data.city}, ND</span></nav>
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <p class="text-earth font-semibold text-sm tracking-[0.2em] uppercase mb-4">Serving North Dakota Farmers</p>
          <h1 class="text-4xl md:text-5xl font-black leading-tight">{data.title}</h1>
          <p class="text-lg text-gray-600 leading-relaxed mt-6">{data.description}</p>
          <a href="/contact" class="inline-block mt-8 bg-primary hover:bg-primary-light text-white px-8 py-4 rounded-lg font-bold transition-colors">Request a Free Estimate</a>
        </div>
        <img src="/images/uploads/drain-tile-installation.webp" alt="Drainage pipe laid alongside agricultural land" class="w-full aspect-[3/2] object-cover rounded-2xl shadow-xl" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-20 items-start">
      <article class="min-w-0 [overflow-wrap:anywhere] prose prose-lg max-w-none prose-headings:font-black prose-headings:tracking-tight prose-a:text-primary prose-a:underline"><Content /></article>
      <aside class="bg-surface rounded-2xl p-7 lg:sticky lg:top-28">
        <h2 class="text-xl font-bold mb-5">Our Services</h2>
        <nav aria-label="Related services" class="space-y-4">
          {services.map(service => <a href={`/services/${service.slug}`} class="block text-sm text-gray-600 hover:underline">{service.data.nav_title}</a>)}
        </nav>
        <h2 class="text-xl font-bold mt-8 mb-5">Service Areas</h2>
        <nav aria-label="Other service areas" class="space-y-4">
          {locations.map(location => <a href={`/service-areas/${location.slug}`} aria-current={location.slug === page.slug ? 'page' : undefined} class={`block text-sm ${location.slug === page.slug ? 'font-bold border-l-4 border-accent pl-3' : 'text-gray-600 hover:underline'}`}>{location.data.city}, ND</a>)}
        </nav>
      </aside>
    </div>
  </section>
  <section class="bg-primary-dark py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-white">Plan Your Drainage Project in {data.city}</h2>
      <p class="text-lg text-white/80 mt-5">Talk with Deep Roots Drainage about your land and request a free estimate.</p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="/contact" class="bg-accent hover:bg-accent-light text-primary-dark px-8 py-4 rounded-lg font-bold transition-colors">Request a Free Estimate</a>
        <a href="tel:+17014993917" class="text-white border border-white/40 px-8 py-4 rounded-lg font-bold hover:bg-white/10">Call (701) 499-3917</a>
      </div>
    </div>
  </section>
</Layout>
