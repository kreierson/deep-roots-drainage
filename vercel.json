{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "deeprootsdrainage.com"
        }
      ],
      "destination": "https://www.deeprootsdrainage.com/:path*",
      "statusCode": 301
    }
  ]
}
